      "modelField": "model",
      "forwardRequestHeaders": ["anthropic-version", "anthropic-beta", "content-type"],
      "safeResponseHeaders": ["content-type", "request-id"],
      "modelSettingFields": []
    },
    {
      "method": "POST",
      "path": "/v1/responses",
      "wireApi": "responses",
      "enabled": true,
      "streamingAllowed": false,
      "paid": true,
