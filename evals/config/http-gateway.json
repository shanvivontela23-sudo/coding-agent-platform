      "enabled": false,
      "streamingAllowed": false,
      "paid": true,
      "modelField": "model",
      "forwardRequestHeaders": ["content-type"],
      "safeResponseHeaders": ["content-type", "x-request-id"],
      "modelSettingFields": ["temperature", "top_p", "max_tokens", "reasoning_effort"]
    }
