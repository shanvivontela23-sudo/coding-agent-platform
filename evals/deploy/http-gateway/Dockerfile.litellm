FROM python:3.12.14-slim@sha256:f77ac9e44ae96ef2c90b8053ea08c31f8be030f824196b0ae4db6d462c84e51f

WORKDIR /app

COPY evals/litellm/requirements.txt /app/evals/litellm/requirements.txt
RUN python -m pip install --require-hashes -r /app/evals/litellm/requirements.txt

COPY evals/deploy/http-gateway/litellm-config.yaml /app/litellm-config.yaml

CMD ["litellm", "--config", "/app/litellm-config.yaml", "--host", "0.0.0.0", "--port", "4000"]
